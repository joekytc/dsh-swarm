{
  "name": "@joekytc/dsh-swarm",
  "version": "0.1.0",
  "description": "Multi-role (V/P/W/D/PT/DT), event-sourced task kanban plugin for DSH with R20 orchestration, evidence-gated delivery and wiki-vault sync",
  "license": "MIT",
  "author": "joekytc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joekytc/dsh-swarm.git"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "kanban",
    "agent",
    "workflow",
    "task-management"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "client",
    "personas",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-persona": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-bash": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-fs-search": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
